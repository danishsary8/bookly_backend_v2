APP_NAME=BookShop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Load balancer in front of the app. REMOTE_ADDR = the machine directly in front (Railway/Render).
# On a VPS list proxy IPs; empty = no proxy. Never '*' (lets visitors fake their IP).
TRUSTED_PROXIES=REMOTE_ADDR

APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Production: LOG_CHANNEL=json_stdout and LOG_REQUESTS=true
LOG_CHANNEL=stack
LOG_REQUESTS=false
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bookshop_v2
DB_USERNAME=bookshop
DB_PASSWORD=bookshop

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production: MAIL_MAILER=resend + RESEND_API_KEY. Without a verified domain Resend only delivers to
# your own Resend account address (from onboarding@resend.dev).
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Auth
SANCTUM_EXPIRATION=10080
# Staff tokens expire sooner (hours).
STAFF_TOKEN_HOURS=12

# Frontend URL(s) allowed to call the API from a browser, comma separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OTP_TTL_MINUTES=15
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Shop
SHIPPING_FEE_PHNOM_PENH=1.50
SHIPPING_FEE_PROVINCES=3.00
RETURN_WINDOW_DAYS=3
UNVERIFIED_CUSTOMER_HOURS=48
SHOP_TIMEZONE=Asia/Phnom_Penh

# Error tracking (leave empty to disable)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Set to true only to run DemoSeeder once on a production demo site, then remove.
DEMO_SEED_ALLOWED=false

# Cloudflare Turnstile (bot check on sign-up, sign-in and code emails). Empty = off.
TURNSTILE_SECRET_KEY=
