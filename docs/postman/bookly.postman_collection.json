    {
      "name": "4. Staff",
      "item": [
        {
          "name": "Staff login (step 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/staff/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "staff",
                "auth",
                "login"
              ]
            },
            "description": "First login: returns a token that only allows 2FA setup. After 2FA is on: returns challenge_token; then use step 2 with the 6-digit code from your authenticator app.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.challenge_token) pm.collectionVariables.set('challengeToken', j.challenge_token);",
                  "if (j.token) pm.collectionVariables.set('staffToken', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "2FA setup (first login only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/staff/auth/two-factor/setup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "staff",
                "auth",
                "two-factor",
                "setup"
              ]
            },
            "description": "Returns otpauth_uri: turn it into a QR code (any 'QR code generator' site) or type the secret into Google Authenticator / Authy.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
